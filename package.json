{
  "name": "gspace-mern-sqlite",
  "version": "2.0.0",
  "description": "GSpace - Personal Cloud Storage built with Node.js, Express, React, and SQLite",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
